obj-m += hello_module.o

KDIR ?= /lib/modules/$(shell uname -r)/build
PWD := $(shell pwd)

# Минимальные флаги
EXTRA_CFLAGS := -fno-pic -fno-stack-protector
CONFIG_MODULE_SIG := n

all:
	@echo "Trying to compile for current kernel: $(shell uname -r)"
	@if [ -d "$(KDIR)" ]; then \
		$(MAKE) -C $(KDIR) M=$(PWD) modules; \
	else \
		echo "Kernel headers not found, trying direct compilation..."; \
		gcc -c hello_module.c -I/usr/include -D__KERNEL__ -DMODULE; \
	fi

clean:
	rm -f *.o *.ko *.mod.c Module.symvers modules.order

load:
	-insmod hello_module.ko --force

unload:
	-rmmod hello_module

.PHONY: all clean
